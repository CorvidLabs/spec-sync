{
  "version": 2,
  "enabled": true,
  "require_change_for_meaningful_files": true,
  "meaningful_paths": [
    "src/",
    "tests/",
    "site/",
    ".github/",
    "Cargo.toml",
    "Cargo.lock",
    "action.yml",
    "package.json",
    "bun.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "Package.swift",
    "Package.resolved",
    "go.mod",
    "go.sum",
    "pyproject.toml",
    "uv.lock",
    "requirements.txt",
    ".specsync/sdd.json",
    ".specsync/config.toml",
    ".specsync/config.json",
    ".specsync/version"
  ],
  "ignored_paths": [
    ".specsync/",
    "specs/"
  ],
  "verification_commands": [
    "ruby --version",
    "cargo test",
    "python3 -S .github/scripts/validate-release-version.py",
    "python3 -S .github/scripts/validate-workflow-runtime-pins.py"
  ],
  "component_verification_commands": {
    "agents": ["cargo test agents::"],
    "change": ["cargo test change::"],
    "cli": ["cargo test cli::tests::"],
    "cli_args": ["cargo test cli::tests::"],
    "cmd_check": ["cargo test commands::check::tests::"],
    "cmd_change": ["cargo test commands::change::"],
    "commands": ["cargo test commands::tests::"],
    "exports": [
      "cargo test exports::typescript::",
      "cargo test exports::erlang::",
      "cargo test exports::ast::erlang::"
    ],
    "github": [
      "bash .github/scripts/test-classify-ci-paths.sh",
      "python3 -S .github/scripts/validate-workflow-runtime-pins.py"
    ],
    "hooks": ["cargo test hooks::tests::"],
    "ignore": ["cargo test ignore::tests::"],
    "schema": ["cargo test schema::tests::"],
    "validator": ["cargo test validator::tests::"]
  },
  "strict_verification_commands": [
    "cargo test",
    "python3 -S .github/scripts/validate-release-version.py",
    "python3 -S .github/scripts/validate-workflow-runtime-pins.py"
  ],
  "strict_paths": [
    "src/change.rs",
    "src/mcp.rs",
    "src/github.rs",
    ".github/workflows/",
    ".specsync/sdd.json"
  ],
  "custom_artifacts": {},
  "principles_file": null
}
