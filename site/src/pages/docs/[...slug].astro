---
import { getCollection } from 'astro:content'
import RedirectPage from '../../components/RedirectPage.astro'
import { hubDocsUrl } from '../../lib/hub'
import { contentSlug } from '../../lib/content'

// Keep enumerating every docs slug (incl. integrations/*) so each retired URL
// still emits a redirect stub pointing at the hub docs.
export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries
    .filter(entry => contentSlug(entry.id) !== 'index')
    .map(entry => {
      const slug = contentSlug(entry.id)
      return { params: { slug }, props: { destination: hubDocsUrl(slug) } }
    })
}

const { destination } = Astro.props
---
<RedirectPage to={destination} />
